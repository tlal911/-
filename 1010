<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>دفتر المذكرات الذكي</title>
  
  <!-- خط Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --bg: #f8fafc;
      --card-bg: #ffffff;
      --text: #0f172a;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --danger: #ef4444;
      --lock: #f59e0b;
      --lock-bg: #fffbeb;
      --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
    }

    * {
      box-sizing: border-box;
      font-family: 'Tajawal', sans-serif;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      display: flex;
      justify-content: center;
      padding: 40px 15px;
      min-height: 100vh;
      overflow-x: hidden;
    }

    .app-container {
      background: var(--card-bg);
      width: 100%;
      max-width: 600px;
      padding: 28px;
      border-radius: 20px;
      box-shadow: var(--shadow);
      height: fit-content;
      border: 1px solid var(--border);
      position: relative;
    }

    /* الشريط العلوي */
    .header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      gap: 8px;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 8px;
      flex: 1;
    }

    /* أداة البحث المدمجة بأيقونة */
    .search-wrapper {
      display: flex;
      align-items: center;
      background: #f1f5f9;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 2px;
      transition: all 0.3s ease;
    }

    .btn-search-icon {
      background: transparent;
      border: none;
      font-size: 0.85rem;
      padding: 4px 8px;
      cursor: pointer;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      transition: color 0.2s ease;
    }

    .btn-search-icon:hover {
      color: var(--primary);
    }

    .search-input-top {
      width: 0;
      opacity: 0;
      padding: 0;
      border: none;
      outline: none;
      background: transparent;
      font-size: 0.8rem;
      transition: all 0.3s ease;
    }

    .search-wrapper.active {
      background: #ffffff;
      border-color: var(--primary);
      box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15);
      flex: 1;
      max-width: 180px;
    }

    .search-wrapper.active .search-input-top {
      width: 100%;
      opacity: 1;
      padding: 4px 6px;
    }

    .header-title h1 {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--text);
      line-height: 1.2;
    }

    /* زر القائمة الجانبية */
    .btn-sidebar-toggle {
      background: #f1f5f9;
      border: 1px solid var(--border);
      font-size: 1.1rem;
      padding: 6px 10px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
      flex-shrink: 0;
    }

    .btn-sidebar-toggle:hover {
      background: #e2e8f0;
    }

    /* القائمة الجانبية */
    .sidebar-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(15, 23, 42, 0.4);
      backdrop-filter: blur(3px);
      z-index: 999;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .sidebar-overlay.active {
      opacity: 1;
      pointer-events: all;
    }

    .sidebar {
      position: fixed;
      top: 0;
      right: -320px;
      width: 300px;
      height: 100%;
      background: #ffffff;
      z-index: 1000;
      box-shadow: -5px 0 25px rgba(0, 0, 0, 0.1);
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      transition: right 0.3s ease;
      overflow-y: auto;
    }

    .sidebar.active {
      right: 0;
    }

    .sidebar-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
      padding-bottom: 12px;
    }

    .sidebar-header h3 {
      font-size: 1.1rem;
      color: var(--text);
    }

    .btn-close-sidebar {
      background: none;
      border: none;
      font-size: 1.2rem;
      cursor: pointer;
      color: var(--text-muted);
    }

    .sidebar-section {
      display: flex;
      flex-direction: column;
      gap: 12px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 16px;
    }

    .sidebar-section h4 {
      font-size: 0.95rem;
      color: var(--text);
    }

    .sidebar-section p {
      font-size: 0.82rem;
      color: var(--text-muted);
      line-height: 1.4;
    }

    .btn-sidebar-action {
      width: 100%;
      padding: 10px 14px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: #f8fafc;
      color: var(--text);
      font-weight: 500;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .btn-sidebar-action:hover {
      background: #eff6ff;
      border-color: var(--primary);
      color: var(--primary);
    }

    /* زر التبديل */
    .switch-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #f8fafc;
      padding: 10px 12px;
      border-radius: 10px;
      border: 1px solid var(--border);
    }

    .switch-container span {
      font-size: 0.9rem;
      font-weight: 500;
    }

    .switch {
      position: relative;
      display: inline-block;
      width: 44px;
      height: 24px;
    }

    .switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }

    .slider {
      position: absolute;
      cursor: pointer;
      top: 0; left: 0; right: 0; bottom: 0;
      background-color: #cbd5e1;
      transition: .3s;
      border-radius: 24px;
    }

    .slider:before {
      position: absolute;
      content: "";
      height: 18px;
      width: 18px;
      left: 3px;
      bottom: 3px;
      background-color: white;
      transition: .3s;
      border-radius: 50%;
    }

    input:checked + .slider {
      background-color: var(--primary);
    }

    input:checked + .slider:before {
      transform: translateX(20px);
    }

    /* عناصر الإدخال */
    .controls {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 24px;
    }

    .input-box {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    textarea, input[type="text"], input[type="password"] {
      width: 100%;
      padding: 12px 16px;
      border: 1px solid var(--border);
      border-radius: 12px;
      font-size: 0.95rem;
      outline: none;
      transition: all 0.2s ease;
      background-color: #f8fafc;
    }

    textarea {
      height: 100px;
      resize: vertical;
    }

    textarea:focus {
      border-color: var(--primary);
      background-color: #ffffff;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    }

    .lock-status-badge {
      display: none;
      align-items: center;
      gap: 6px;
      font-size: 0.82rem;
      color: #b45309;
      background-color: #fef3c7;
      padding: 6px 12px;
      border-radius: 8px;
      font-weight: 500;
    }

    .btn-primary {
      background-color: var(--primary);
      color: #ffffff;
      border: none;
      padding: 12px 20px;
      border-radius: 12px;
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .btn-primary:hover {
      background-color: var(--primary-hover);
    }

    /* قائمة المذكرات */
    .notes-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
    }

    .notes-header h2 {
      font-size: 1.1rem;
      color: var(--text);
    }

    .notes-count {
      font-size: 0.85rem;
      background: #eff6ff;
      color: var(--primary);
      padding: 2px 10px;
      border-radius: 12px;
      font-weight: 700;
    }

    .notes-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-height: 400px;
      overflow-y: auto;
      padding-left: 2px;
    }

    .note-card {
      background: #ffffff;
      border: 1px solid var(--border);
      border-right: 4px solid var(--primary);
      padding: 16px;
      border-radius: 12px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
    }

    .note-card.locked-card {
      border-right-color: var(--lock);
      background-color: var(--lock-bg);
    }

    .note-content {
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex: 1;
    }

    .note-text {
      font-size: 0.95rem;
      color: var(--text);
      white-space: pre-wrap;
      word-break: break-word;
      line-height: 1.5;
    }

    .locked-placeholder {
      display: flex;
      align-items: center;
      gap: 6px;
      color: #b45309;
      font-weight: 500;
      font-size: 0.9rem;
    }

    .note-date {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .note-actions {
      display: flex;
      gap: 6px;
    }

    .btn-action {
      background: #f1f5f9;
      border: none;
      cursor: pointer;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 500;
      transition: all 0.2s ease;
    }

    .btn-unlock-trigger {
      color: #b45309;
      background-color: #fef3c7;
    }

    .btn-unlock-trigger:hover {
      background-color: #fde68a;
    }

    .btn-delete {
      color: var(--text-muted);
    }

    .btn-delete:hover {
      background-color: #fee2e2;
      color: var(--danger);
    }

    .empty-state {
      text-align: center;
      padding: 30px 10px;
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    /* النافذة المنبثقة لفك القفل */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(5px);
      display: flex;
      justify-content: center;
      align-items: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
      z-index: 1001;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: all;
    }

    .modal-card {
      background: #ffffff;
      width: 90%;
      max-width: 380px;
      padding: 24px;
      border-radius: 16px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 16px;
      transform: scale(0.95);
      transition: transform 0.25s ease;
    }

    .modal-overlay.active .modal-card {
      transform: scale(1);
    }

    .modal-card h3 {
      font-size: 1.1rem;
      color: var(--text);
    }

    .modal-card p {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .modal-actions {
      display: flex;
      gap: 10px;
    }

    .btn-modal-submit {
      flex: 1;
      background: var(--primary);
      color: #fff;
      border: none;
      padding: 10px;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
    }

    .btn-modal-cancel {
      flex: 1;
      background: #f1f5f9;
      color: var(--text);
      border: none;
      padding: 10px;
      border-radius: 8px;
      cursor: pointer;
    }

    .error-msg {
      color: var(--danger);
      font-size: 0.8rem;
      display: none;
    }
  </style>
</head>
<body>

<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<div class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <h3>⚙️ الخيارات والإنضباط</h3>
    <button class="btn-close-sidebar" onclick="closeSidebar()">✕</button>
  </div>

  <div class="sidebar-section">
    <h4>🔒 حماية المذكرة القادمة</h4>
    <p>قم بتفعيل هذا الخيار إذا كنت تريد تعيين كلمة مرور للمذكرة التي تُدخلها الآن:</p>
    
    <div class="switch-container">
      <span>قفل المذكرة بكلمة مرور</span>
      <label class="switch">
        <input type="checkbox" id="sidebarLockToggle" onchange="toggleSidebarLock(this)">
        <span class="slider"></span>
      </label>
    </div>

    <div id="sidebarPassBox" style="display: none; flex-direction: column; gap: 8px; margin-top: 8px;">
      <input type="password" id="sidebarPassInput" placeholder="أدخل كلمة مرور المذكرة">
    </div>
  </div>

  <!-- قسم النسخ الاحتياطي (مُعدّل ومُصلح) -->
  <div class="sidebar-section" style="border: none;">
    <h4>📦 النسخ الاحتياطي</h4>
    <p>احفظ نسخة من جميع مذكراتك في ملف خارج المتصفح لاسترجاعها في أي وقت:</p>

    <button class="btn-sidebar-action" onclick="exportNotes()">
      <span>📥</span> تصدير المذكرات (تحميل)
    </button>

    <button class="btn-sidebar-action" onclick="document.getElementById('importFileInput').click()">
      <span>📤</span> استيراد مذكرات (رفع)
    </button>

    <input type="file" id="importFileInput" accept=".json" style="display: none;" onchange="importNotes(event)">
  </div>
</div>

<div class="app-container">
  <div class="header-bar">
    <div class="header-right">
      <div class="search-wrapper" id="searchWrapper">
        <button class="btn-search-icon" onclick="toggleSearch()" title="بحث">🔍</button>
        <input type="text" id="searchInput" class="search-input-top" placeholder="بحث..." oninput="filterNotes()">
      </div>

      <div class="header-title" id="headerTitle">
        <h1>📝 دفتر المذكرات</h1>
      </div>
    </div>

    <button class="btn-sidebar-toggle" onclick="openSidebar()" title="الخيارات">☰</button>
  </div>

  <div class="controls">
    <div class="input-box">
      <textarea id="noteInput" placeholder="اكتب مذكرتك الجديدة هنا..."></textarea>
      
      <div id="lockBadge" class="lock-status-badge">
        <span>🔒 تم تفعيل القفل من القائمة الجانبية، هذه المذكرة ستكون محمية.</span>
      </div>

      <button class="btn-primary" onclick="addNote()">حفظ المذكرة</button>
    </div>
  </div>

  <div class="notes-header">
    <h2>المذكرات المحفوظة</h2>
    <span id="notesCount" class="notes-count">0</span>
  </div>

  <ul id="notesList" class="notes-list"></ul>
</div>

<div class="modal-overlay" id="unlockModal">
  <div class="modal-card">
    <div style="font-size: 2.5rem;">🔒</div>
    <h3>المذكرة مقفلة</h3>
    <p>أدخل كلمة المرور لعرض أو حذف هذه المذكرة</p>
    
    <input type="password" id="modalPassInput" placeholder="أدخل كلمة المرور">
    <span class="error-msg" id="modalError">كلمة المرور غير صحيحة!</span>

    <div class="modal-actions">
      <button class="btn-modal-submit" onclick="submitUnlock()">فتح</button>
      <button class="btn-modal-cancel" onclick="closeModal()">إلغاء</button>
    </div>
  </div>
</div>

<script>
  let unlockedNoteIds = [];
  let pendingNoteId = null;
  let pendingAction = null;

  document.addEventListener('DOMContentLoaded', () => {
    loadNotes();
  });

  function getStoredNotes() {
    const notes = localStorage.getItem('pro_saved_notes');
    return notes ? JSON.parse(notes) : [];
  }

  function saveToStorage(notes) {
    localStorage.setItem('pro_saved_notes', JSON.stringify(notes));
  }

  function toggleSearch() {
    const wrapper = document.getElementById('searchWrapper');
    const input = document.getElementById('searchInput');

    wrapper.classList.toggle('active');

    if (wrapper.classList.contains('active')) {
      input.focus();
    } else {
      input.value = '';
      filterNotes();
    }
  }

  function openSidebar() {
    document.getElementById('sidebar').classList.add('active');
    document.getElementById('sidebarOverlay').classList.add('active');
  }

  function closeSidebar() {
    document.getElementById('sidebar').classList.remove('active');
    document.getElementById('sidebarOverlay').classList.remove('active');
  }

  function toggleSidebarLock(checkbox) {
    const passBox = document.getElementById('sidebarPassBox');
    const badge = document.getElementById('lockBadge');

    if (checkbox.checked) {
      passBox.style.display = 'flex';
      badge.style.display = 'flex';
      document.getElementById('sidebarPassInput').focus();
    } else {
      passBox.style.display = 'none';
      badge.style.display = 'none';
      document.getElementById('sidebarPassInput').value = '';
    }
  }

  /* تم إصلاح وتحديث دالة التصدير باستخدام Blob */
  function exportNotes() {
    const notes = getStoredNotes();
    if (!notes || notes.length === 0) {
      alert('لا توجد مذكرات لتصديرها!');
      return;
    }

    try {
      const jsonStr = JSON.stringify(notes, null, 2);
      const blob = new Blob([jsonStr], { type: 'application/json' });
      const url = URL.createObjectURL(blob);

      const downloadAnchor = document.createElement('a');
      downloadAnchor.href = url;
      downloadAnchor.download = `notes_backup_${new Date().toISOString().slice(0,10)}.json`;
      
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      
      setTimeout(() => {
        document.body.removeChild(downloadAnchor);
        URL.revokeObjectURL(url);
      }, 100);
    } catch (err) {
      alert('حدث خطأ أثناء محاولة التصدير!');
      console.error(err);
    }
  }

  function importNotes(event) {
    const file = event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(e) {
      try {
        const importedNotes = JSON.parse(e.target.result);
        if (Array.isArray(importedNotes)) {
          saveToStorage(importedNotes);
          loadNotes();
          alert('تم استيراد المذكرات بنجاح!');
          closeSidebar();
        } else {
          alert('ملف النسخة الاحتياطية غير صالح!');
        }
      } catch (err) {
        alert('حدث خطأ أثناء قراءة الملف!');
      }
    };
    reader.readAsText(file);
    event.target.value = '';
  }

  function loadNotes(filterText = '') {
    const notes = getStoredNotes();
    const listElement = document.getElementById('notesList');
    const countElement = document.getElementById('notesCount');
    
    listElement.innerHTML = '';

    const filteredNotes = notes.filter(note => {
      const isUnlocked = unlockedNoteIds.includes(note.id);
      if (note.isLocked && !isUnlocked) {
        return "مذكرة مقفلة".includes(filterText.toLowerCase());
      }
      return note.text.toLowerCase().includes(filterText.toLowerCase());
    });

    countElement.textContent = filteredNotes.length;

    if (filteredNotes.length === 0) {
      listElement.innerHTML = `
        <div class="empty-state">
          ${filterText ? 'لا توجد نتائج تطابق بحثك.' : 'لا توجد مذكرات محفوظة بعد.'}
        </div>`;
      return;
    }

    filteredNotes.forEach((note) => {
      const isUnlocked = unlockedNoteIds.includes(note.id);
      const isCurrentlyLocked = note.isLocked && !isUnlocked;

      const li = document.createElement('li');
      li.className = `note-card ${isCurrentlyLocked ? 'locked-card' : ''}`;
      
      let noteContentHTML = '';
      let actionButtonsHTML = '';

      if (isCurrentlyLocked) {
        noteContentHTML = `
          <div class="locked-placeholder">
            <span>🔒</span>
            <span>مذكرة محمية بكلمة مرور</span>
          </div>`;
        actionButtonsHTML = `<button class="btn-action btn-unlock-trigger" onclick="openUnlockModal(${note.id}, 'unlock')">🔑 إلغاء القفل</button>`;
      } else {
        noteContentHTML = `<p class="note-text">${escapeHtml(note.text)}</p>`;
        if (note.isLocked) {
          actionButtonsHTML += `<button class="btn-action" onclick="lockNote(${note.id})">🔒 قفل</button>`;
        }
      }

      actionButtonsHTML += `<button class="btn-action btn-delete" onclick="handleDelete(${note.id})" title="حذف">حذف</button>`;

      li.innerHTML = `
        <div class="note-content">
          ${noteContentHTML}
          <span class="note-date">${note.date}</span>
        </div>
        <div class="note-actions">
          ${actionButtonsHTML}
        </div>
      `;
      listElement.appendChild(li);
    });
  }

  function addNote() {
    const input = document.getElementById('noteInput');
    const isLockEnabled = document.getElementById('sidebarLockToggle').checked;
    const password = document.getElementById('sidebarPassInput').value.trim();
    const text = input.value.trim();

    if (!text) return;

    if (isLockEnabled && !password) {
      alert('يرجى كتابة كلمة مرور للمذكرة في القائمة الجانبية، أو قم بإيقاف خيار القفل.');
      openSidebar();
      return;
    }

    const notes = getStoredNotes();
    
    const newNote = {
      id: Date.now(),
      text: text,
      isLocked: isLockEnabled && password.length > 0,
      password: isLockEnabled ? password : '',
      date: new Date().toLocaleString('ar-EG', { dateStyle: 'short', timeStyle: 'short' })
    };

    notes.unshift(newNote);
    saveToStorage(notes);

    input.value = '';
    document.getElementById('sidebarLockToggle').checked = false;
    toggleSidebarLock(document.getElementById('sidebarLockToggle'));
    document.getElementById('searchInput').value = '';
    loadNotes();
  }

  function openUnlockModal(id, action) {
    pendingNoteId = id;
    pendingAction = action;
    document.getElementById('modalPassInput').value = '';
    document.getElementById('modalError').style.display = 'none';
    document.getElementById('unlockModal').classList.add('active');
    document.getElementById('modalPassInput').focus();
  }

  function closeModal() {
    document.getElementById('unlockModal').classList.remove('active');
    pendingNoteId = null;
    pendingAction = null;
  }

  function submitUnlock() {
    const inputPass = document.getElementById('modalPassInput').value;
    const notes = getStoredNotes();
    const note = notes.find(n => n.id === pendingNoteId);

    if (note && inputPass === note.password) {
      if (pendingAction === 'unlock') {
        unlockedNoteIds.push(pendingNoteId);
      } else if (pendingAction === 'delete') {
        performDelete(pendingNoteId);
      }
      closeModal();
      loadNotes(document.getElementById('searchInput').value);
    } else {
      document.getElementById('modalError').style.display = 'block';
    }
  }

  function lockNote(id) {
    unlockedNoteIds = unlockedNoteIds.filter(unlockedId => unlockedId !== id);
    loadNotes(document.getElementById('searchInput').value);
  }

  function handleDelete(id) {
    const notes = getStoredNotes();
    const note = notes.find(n => n.id === id);

    if (note && note.isLocked && !unlockedNoteIds.includes(id)) {
      openUnlockModal(id, 'delete');
    } else {
      performDelete(id);
    }
  }

  function performDelete(id) {
    let notes = getStoredNotes();
    notes = notes.filter(n => n.id !== id);
    unlockedNoteIds = unlockedNoteIds.filter(unlockedId => unlockedId !== id);
    saveToStorage(notes);
    loadNotes(document.getElementById('searchInput').value);
  }

  function filterNotes() {
    loadNotes(document.getElementById('searchInput').value);
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.innerText = text;
    return div.innerHTML;
  }
</script>

</body>
